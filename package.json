{
  "name": "esqia",
  "version": "0.1.2",
  "description": "Edit your MDX from the rendered page while you write. A dev-only editor for Next.js.",
  "keywords": [
    "mdx",
    "next",
    "editor",
    "markdown",
    "wysiwyg",
    "writing"
  ],
  "homepage": "https://esqia.jakub.kr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubkrehel/esqia.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:web": "pnpm --filter web build",
    "check": "pnpm lint && biome check --error-on-warnings .",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:lib": "tsdown --watch src",
    "dev:web": "pnpm --filter web dev",
    "fix": "oxlint --fix . && biome check --write .",
    "format": "biome format --write .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm build && pnpm --filter web typecheck"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bold": "^3.32.2",
    "@tiptap/extension-code": "^3.32.2",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-italic": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@vercel/blob": "^2.8.2",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-to-markdown": "^2.2.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.3",
    "oxlint": "1.88.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
